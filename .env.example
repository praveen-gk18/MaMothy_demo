# Demo mode is active until both MSG91 values are configured.
# Create a DLT-approved SMS template and an MSG91 SMS Flow, then use its Flow/template ID below.
# Keep credentials private; never commit your real .env file.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Choose a private random PIN of at least 8 characters; enter it in the SMS form for each send.
SMS_ADMIN_PIN=
PORT=3001
