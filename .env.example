# Trial mode is the default. Twilio trial sends a fixed predefined template, not custom text.
# Use the trial SMS number Twilio assigned to your account as TWILIO_FROM_NUMBER.
# Keep credentials private; never commit your real .env file.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TRIAL_MODE=true
PORT=3001
